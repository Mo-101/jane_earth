{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/v1/hazards/[type]",
      "regex": "^/api/v1/hazards/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtype": "nxtPtype"
      },
      "namedRegex": "^/api/v1/hazards/(?<nxtPtype>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/v1/reports/[id]/verify",
      "regex": "^/api/v1/reports/([^/]+?)/verify(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/reports/(?<nxtPid>[^/]+?)/verify(?:/)?$"
    },
    {
      "page": "/api/v1/tiles/[layer]/[z]/[x]/[y]",
      "regex": "^/api/v1/tiles/([^/]+?)/([^/]+?)/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlayer": "nxtPlayer",
        "nxtPz": "nxtPz",
        "nxtPx": "nxtPx",
        "nxtPy": "nxtPy"
      },
      "namedRegex": "^/api/v1/tiles/(?<nxtPlayer>[^/]+?)/(?<nxtPz>[^/]+?)/(?<nxtPx>[^/]+?)/(?<nxtPy>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/analytics",
      "regex": "^/analytics(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/analytics(?:/)?$"
    },
    {
      "page": "/api/alerts",
      "regex": "^/api/alerts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/alerts(?:/)?$"
    },
    {
      "page": "/api/alerts/gdacs",
      "regex": "^/api/alerts/gdacs(?:/)?$",
      "routeKeys": {},
