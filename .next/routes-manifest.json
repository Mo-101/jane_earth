      "routeKeys": {},
      "namedRegex": "^/api/alerts/nasa(?:/)?$"
    },
    {
      "page": "/api/alerts/reliefweb",
      "regex": "^/api/alerts/reliefweb(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/alerts/reliefweb(?:/)?$"
    },
    {
      "page": "/api/pipeline/ingest",
      "regex": "^/api/pipeline/ingest(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/pipeline/ingest(?:/)?$"
    },
    {
      "page": "/api/pipeline/status",
      "regex": "^/api/pipeline/status(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/pipeline/status(?:/)?$"
    },
    {
      "page": "/api/reports",
      "regex": "^/api/reports(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/reports(?:/)?$"
    },
    {
      "page": "/api/v1/hazards/realtime",
      "regex": "^/api/v1/hazards/realtime(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/v1/hazards/realtime(?:/)?$"
    },
    {
      "page": "/api/v1/health",
      "regex": "^/api/v1/health(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/v1/health(?:/)?$"
    },
    {
      "page": "/api/v1/pipeline/status",
      "regex": "^/api/v1/pipeline/status(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/v1/pipeline/status(?:/)?$"
    },
    {
      "page": "/api/v1/reports",
